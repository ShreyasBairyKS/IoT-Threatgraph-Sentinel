{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IncidentReport",
  "description": "Contract 4.5 - P3 output for report generation. Frozen on Day 1.",
  "type": "object",
  "required": [
    "report_id", "generated_at", "incident_summary",
    "affected_devices", "evidence", "recommendations"
  ],
  "properties": {
    "report_id":        { "type": "string" },
    "generated_at":    { "type": "string", "format": "date-time" },
    "incident_summary":{ "type": "string" },
    "affected_devices":{ "type": "array", "items": { "type": "string" } },
    "evidence": {
      "type": "object",
      "required": ["risk_score", "explanations", "mitre"],
      "properties": {
        "risk_score":   { "type": "number" },
        "explanations": { "type": "array", "items": { "type": "string" } },
        "mitre": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tactic", "technique"],
            "properties": {
              "tactic":    { "type": "string" },
              "technique": { "type": "string" }
            }
          }
        }
      }
    },
    "recommendations": { "type": "array", "items": { "type": "string" } }
  }
}
